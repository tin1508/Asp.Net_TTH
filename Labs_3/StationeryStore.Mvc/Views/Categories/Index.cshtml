
@model List<CategoryListItemViewModel>

@{
    ViewData["Title"] = "Category Catalog";
    var totalItems = Model.Count;
}

<!-- set up icon for categories list page-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<div class="page-header">
    <div>
        <h2 class="page-title">
            <i class="ti ti-folders page-title-icon" aria-hidden="true"></i>
            <span>Category Catalog</span>
        </h2>
        <p class="page-description">
            Đây là trang danh sách danh mục sản phẩm của cửa hàng.
        </p>
    </div>
</div>

<div class="info-panel">
    <i class="ti ti-category info-panel-icon" aria-hidden="true"></i>
    <div>
        <span class="info-panel-label">Tổng số danh mục sản phẩm</span>
        <span class="info-panel-value">@totalItems</span>
    </div>
</div>

@if(Model.Count == 0){
    <div class="empty-state">
        <i class="ti ti-inbox" aria-hidden="true"></i>
        <p>Chưa có nhóm sản phẩm nào trong hệ thống.</p>
    </div>
}
else{
    <div class="catalog-table-wrap">
        <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
            <table class="catalog-table">
                <thead>
                    <tr>
                        <th><i class="ti ti-folder" aria-hidden="true"></i> Tên nhóm</th>
                        <th class="count-column">
                            <i class="ti ti-packages" aria-hidden="true"></i>
                            Số lượng sản phẩm
                        </th>
                        <th><i class="ti ti-eye" aria-hidden="true"></i> Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (CategoryListItemViewModel item in Model)
                    {
                        <tr>
                            <td class="name-cell">@item.Name</td>
                            <td class="qty-cell count-column">@item.StationeryCount</td>
                            <td class="action-cell">
                                <a class="btn-detail" href="/Categories/Detail/@item.Id">
                                    <i class="ti ti-eye" aria-hidden="true"></i>
                                    Xem
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<div class="mt-4">
    <a class="btn btn-theme-back" href="/">
        <i class="ti ti-arrow-left" aria-hidden="true"></i>
        Quay lại trang chủ
    </a>
</div>