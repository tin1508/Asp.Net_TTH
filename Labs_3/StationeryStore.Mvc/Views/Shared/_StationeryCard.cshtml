@model StationeryListItemViewModel

<div class="stationery-card">
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>
        <p class="card-sku">SKU: @Model.Sku</p>
        <p class="card-category">Danh mục: @Model.Category?.Name</p>

        <div class="card-info">
            <span class="card-price">@Model.PriceText</span>
            <span class="card-quantity">Số lượng: @Model.Quantity</span>
        </div>

        <div class="card-bottom">
            @if (Model.StockStatus == "In stock")
            {
                <span class="badge badge-success">@Model.StockStatus</span>
            }
            else if (Model.StockStatus == "Need to add more stock")
            {
                <span class="badge badge-warning">@Model.StockStatus</span>
            }
            else
            {
                <span class="badge badge-danger">@Model.StockStatus</span>
            }

            <div class="card-actions">
                <a class="btn btn-sm btn-primary"
                   asp-controller="Stationeries"
                   asp-action="Detail"
                   asp-route-id="@Model.Id">
                    <i class="ti ti-eye"></i> Chi tiết
                </a>
            </div>
        </div>
    </div>
</div>