@model List<StationeryListItemViewModel>

@{
    ViewData["Title"] = "Stationeries Catalog";
    var totalItems = Model.Count;
}

<!-- set up icon for stationeries list page-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<div class="page-header">
    <div>
        <h2 class="page-title">
            <i class="ti ti-pencil page-title-icon" aria-hidden="true"></i>
            <span>Stationeries Catalog</span>
        </h2>
        <p class="page-description">
            Đây là trang danh sách sản phẩm của cửa hàng.
        </p>
    </div>

    <div>
        <a class="btn btn-primary" href="/Stationeries/Stats">
            <i class="ti ti-chart-bar" aria-hidden="true"></i>
            Xem thống kê tồn kho
        </a>
    </div>
</div>

<div class="info-panel">
    <i class="ti ti-package info-panel-icon" aria-hidden="true"></i>
    <div>
        <span class="info-panel-label">Tổng số sản phẩm</span>
        <span class="info-panel-value">@totalItems</span>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="ti ti-inbox" aria-hidden="true"></i>
        <p>Chưa có sản phẩm nào trong hệ thống.</p>
    </div>
}
else
{
    
     <div class="catalog-table-wrap">
        <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
            <table class="catalog-table">
                <thead>
                    <tr>
                        <th><i class="ti ti-barcode" aria-hidden="true"></i> SKU</th>
                        <th><i class="ti ti-pencil" aria-hidden="true"></i> Tên sản phẩm</th>
                        <th><i class="ti ti-folder" aria-hidden="true"></i> Danh mục</th>
                        <th><i class="ti ti-tag" aria-hidden="true"></i> Giá bán</th>
                        <th><i class="ti ti-stack" aria-hidden="true"></i> Số lượng</th>
                        <th><i class="ti ti-currency-dollar" aria-hidden="true"></i> Giá trị tồn kho</th>
                        <th><i class="ti ti-circle-check" aria-hidden="true"></i> Trạng thái</th>
                        <th><i class="ti ti-stack" aria-hidden="true"></i> Chi tiết</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (StationeryListItemViewModel item in Model)
                    {
                        <tr>
                            <td class="sku-cell">@item.Sku</td>
                            <td class="name-cell">@item.Name</td>
                            <td class="cat-cell">@item.Category?.Name</td>
                            <td class="price-cell">@item.PriceText</td>
                            <td class="qty-cell">@item.Quantity</td>
                            <td class="val-cell">@item.InventoryValueText</td>
                            <td>
                                <span class="@item.StockStatusClass">
                                    @item.StockStatus
                                </span>
                            </td>
                            <td class="action-cell">
                                <a class="btn-detail" href="/Stationeries/Detail/@item.Id">
                                    <i class="ti ti-eye" aria-hidden="true"></i>
                                    Xem
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-4">
    <a class="btn btn-theme-back" href="/">
        <i class="ti ti-arrow-left" aria-hidden="true"></i>
        Quay lại trang chủ
    </a>
</div>