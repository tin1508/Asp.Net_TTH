@model OrderCreateViewModel
@{
    ViewData["Title"] = "Tạo đơn hàng";
}

<div class="page-header" style="margin-top: 1.5rem">
    <h1 class="page-title">Tạo đơn hàng</h1>
</div>

<div class="form-layout">
    <div class="form-box">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="error-box">@TempData["ErrorMessage"]</div>
        }

        <form id="orderForm" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Tên khách hàng</label>
                <input asp-for="CustomerName" class="form-control" placeholder="Nhập tên khách hàng" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Sản phẩm</label>
                <div id="items-container">
                    <div class="item-row" style="display:flex; gap:8px; margin-bottom:8px;">
                        <select name="Items[0].StationeryId" class="form-control" required>
                            <option value="">-- Chọn sản phẩm --</option>
                            @foreach (var s in Model.AvailableStationeries)
                            {
                                <option value="@s.Id">
                                    @s.Name — @s.Price.ToString("N0")đ (Còn @s.Stock)
                                </option>
                            }
                        </select>
                        <input name="Items[0].Quantity" type="number" min="1" 
                               class="form-control" value="1" style="width:100px;" required />
                        <button type="button" class="btn btn-danger btn-sm remove-row">✕</button>
                    </div>
                </div>
            </div> <button type="button" class="btn btn-secondary btn-sm" id="add-item" style="margin-bottom: 15px;">
                + Thêm sản phẩm
            </button>
            <div class="form-group" style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #ddd;">
                <h4 style="margin: 0;">Tổng tiền: <strong id="total-amount" class="text-primary">0đ</strong></h4>
            </div>
            <br/>
            <button type="submit" class="btn btn-primary">Tạo đơn hàng</button>
            <a href="/Orders" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>

    <div class="info-box">
        <h3>Hướng dẫn</h3>
        <p>Nhập tên khách hàng và chọn sản phẩm cùng số lượng.</p>
        <p>Nhấn <strong>"+ Thêm sản phẩm"</strong> để thêm nhiều mặt hàng.</p>
        <p>Tổng tiền được tính: <strong>Đơn giá × Số lượng</strong>.</p>
    </div>
</div>


@section Scripts {
<script>
    // Stationeries from server
    const stationeries = @Html.Raw(Json.Serialize(Model.AvailableStationeries));
    let rowIndex = 1;

    function calculateTotal() {
        let total = 0;
        const rows = document.querySelectorAll('.item-row');

        rows.forEach(row => {
            const select = row.querySelector('select');
            const qtyInput = row.querySelector('input[type="number"]');
            
            const selectedId = select.value;
            const quantity = parseInt(qtyInput.value) || 0;

            if (selectedId && selectedId !== "") {
                // Find the selected item in our server data (handling JSON casing safely)
                const item = stationeries.find(s => {
                    const id = s.id !== undefined ? s.id : s.Id;
                    return id.toString() === selectedId;
                });

                if (item) {
                    const price = item.price !== undefined ? item.price : item.Price;
                    total += (price * quantity);
                }
            }
        });

        // Update the UI
        document.getElementById('total-amount').innerText = total.toLocaleString('vi-VN') + 'đ';
    }
    document.getElementById('items-container').addEventListener('change', calculateTotal);
    document.getElementById('items-container').addEventListener('input', calculateTotal);
    document.getElementById('add-item').addEventListener('click', () => {
        const container = document.getElementById('items-container');

        // FIX 5: Support both camelCase and PascalCase JSON to prevent 'undefined' values
        const options = stationeries.map(s => {
            const id = s.id !== undefined ? s.id : s.Id;
            const name = s.name || s.Name;
            const price = s.price !== undefined ? s.price : s.Price;
            const stock = s.stock !== undefined ? s.stock : s.Stock;
            return `<option value="${id}">${name} — ${price.toLocaleString('vi-VN')}đ (Còn ${stock})</option>`;
        }).join('');

        const row = document.createElement('div');
        row.className = 'item-row';
        row.style = 'display:flex; gap:8px; margin-bottom:8px;';
        row.innerHTML = `
            <select name="Items[${rowIndex}].StationeryId" class="form-control" required>
                <option value="">-- Chọn sản phẩm --</option>
                ${options}
            </select>
            <input name="Items[${rowIndex}].Quantity" type="number" min="1"
                   class="form-control" value="1" style="width:100px;" required />
            <button type="button" class="btn btn-danger btn-sm remove-row">✕</button>
        `;

        container.appendChild(row);
        rowIndex++;
        calculateTotal();
    });

    document.getElementById('items-container').addEventListener('click', e => {
        if (e.target.classList.contains('remove-row')) {
            const rows = document.querySelectorAll('.item-row');
            if (rows.length > 1) { 
                e.target.closest('.item-row').remove();
                reindexRows(); 
                calculateTotal();
            }
        }
    });

    //Reindex to avoid model binding errors when deleting 
    function reindexRows() {
        document.querySelectorAll('.item-row').forEach((row, i) => {
            row.querySelector('select').name = `Items[${i}].StationeryId`;
            row.querySelector('input').name = `Items[${i}].Quantity`;
        });
        rowIndex = document.querySelectorAll('.item-row').length;
    }
    document.getElementById('orderForm').addEventListener('submit', e => {
        const selects = document.querySelectorAll('.item-row select');
        
        // Ensure NO row is left empty 
        const hasEmptyRow = Array.from(selects).some(s => s.value === '0' || s.value === '');
        
        if (hasEmptyRow) {
            e.preventDefault();
            alert('Please choose a stationery for all rows! (Vui lòng chọn sản phẩm cho tất cả các dòng, hoặc xóa dòng thừa)');
        }
    });
    calculateTotal();
</script>
}