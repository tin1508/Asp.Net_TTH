@model StationeryDetailViewModel

@{
    ViewData["Title"] = "Stationery Detail";
    var stockTone = Model.StockStatus == "Out of stock"
        ? "detail-danger"
        : Model.Quantity <= Model.MinStock
            ? "detail-warning"
            : "detail-safe";

    var stockIcon = Model.StockStatus == "Out of stock"
        ? "ti-alert-triangle"
        : Model.Quantity <= Model.MinStock
            ? "ti-refresh-alert"
            : "ti-shield-check";
}

<!-- set up icon for detailed stationeries page-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<div class="page-header">
    <div>
        <h2 class="page-title">
            <i class="ti ti-file-description page-title-icon" aria-hidden="true"></i>
            <span>Stationery Detail</span>
        </h2>
        <p class="page-description">
            Thông tin chi tiết của sản phẩm trong kho.
        </p>
    </div>

     <a class="btn btn-theme-back" href="/Stationeries">
        <i class="ti ti-arrow-left" aria-hidden="true"></i>
        Quay lại danh sách
    </a>
</div>

<div class="detail-layout">
    <div class="catalog-table-wrap detail-table-wrap">
        <table class="catalog-table detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>@Model.Id</td>
                </tr>

                <tr>
                    <th>SKU</th>
                    <td>@Model.Sku</td>
                </tr>

                <tr>
                    <th>Tên sản phẩm</th>
                    <td>@Model.Name</td>
                </tr>

                <tr>
                    <th>Danh mục</th>
                    <td>@Model.Category?.Name</td>
                </tr>

                <tr>
                    <th>Nhà cung cấp</th>
                    <td>@Model.Supplier</td>
                </tr>

                <tr>
                    <th>Giá bán</th>
                    <td>@Model.PriceText</td>
                </tr>

                <tr>
                    <th>Số lượng tồn kho</th>
                    <td>@Model.Quantity</td>
                </tr>

                <tr>
                    <th>Mức tồn tối thiểu</th>
                    <td>@Model.MinStock</td>
                </tr>

                <tr>
                    <th>Giá trị tồn kho</th>
                    <td>@Model.InventoryValueText</td>
                </tr>

                <tr>
                    <th>Trạng thái</th>
                    <td>@Model.StockStatus</td>
                </tr>

                <tr>
                    <th>Gợi ý nhập hàng</th>
                    <td>@Model.ReorderSuggestion</td>
                </tr>

                <tr>
                    <th>Cập nhật lần cuối</th>
                    <td>@Model.LastUpdatedAt</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="detail-side">
        <div class="side-card @stockTone">
            <i class="ti @stockIcon side-card-icon" aria-hidden="true"></i>
            <h4>Trạng thái tồn kho</h4>
            <h3>@Model.StockStatus</h3>
            <p>@Model.ReorderSuggestion</p>
        </div>

        <div class="side-card detail-info">
            <i class="ti ti-cash side-card-icon" aria-hidden="true"></i>
            <h4>Giá trị tồn kho hiện tại</h4>
            <h3>@Model.InventoryValueText</h3>
            <p>Tính theo giá bán và số lượng tồn kho hiện có.</p>
        </div>

        <div class="side-card detail-safe">
            <i class="ti ti-clock-check side-card-icon" aria-hidden="true"></i>
            <h4>Cập nhật lần cuối</h4>
            <h3>@Model.LastUpdatedAt</h3>
            <p>Thông tin sản phẩm được cập nhật gần nhất.</p>
        </div>
    </div>
</div>
