@model CategoryDetailViewModel

@{
    ViewData["Title"] = "Category Detail";
}

<!-- set up icon for detailed categories list page-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">


<div class="page-header">
    <div>
        <h2 class="page-title">
            <i class="ti ti-folder-open page-title-icon" aria-hidden="true"></i>
            <span>Category Detail</span>
        </h2>
        <p class="page-description">
            Thông tin chi tiết của nhóm sản phẩm trong kho.
        </p>
    </div>

    <a class="btn btn-theme-back" href="/Categories">
        <i class="ti ti-arrow-left" aria-hidden="true"></i>
        Quay lại danh sách
    </a>
</div>

<div class="detail-layout category-detail-layout">
    <div class="catalog-table-wrap detail-table-wrap">
        <table class="catalog-table detail-table">
            <tbody>
                <tr>
                    <th><i class="ti ti-hash" aria-hidden="true"></i> ID</th>
                    <td>@Model.Id</td>
                </tr>

                <tr>
                    <th><i class="ti ti-folder" aria-hidden="true"></i> Tên nhóm sản phẩm</th>
                    <td class="cat-cell">@Model.Name</td>
                </tr>

                <tr>
                    <th><i class="ti ti-packages" aria-hidden="true"></i> Số lượng sản phẩm</th>
                    <td class="detail-qty-cell">@Model.Stationeries.Count</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="side-card detail-info category-summary-card">
        <i class="ti ti-category side-card-icon" aria-hidden="true"></i>
        <h4>Nhóm sản phẩm</h4>
        <h3>@Model.Name</h3>
        <p>Có @Model.Stationeries.Count sản phẩm thuộc nhóm này.</p>
    </div>
</div>

<div class="catalog-table-wrap category-products-wrap">
    <table class="catalog-table">
        <thead>
            <tr>
                <th><i class="ti ti-list" aria-hidden="true"></i> Danh sách sản phẩm</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Stationeries.Count == 0)
            {
                <tr>
                    <td>Chưa có sản phẩm nào thuộc nhóm này.</td>
                </tr>
            }
            else
            {
                @foreach (StationeryListItemViewModel stationery in Model.Stationeries)
                {
                    <tr>
                        <td class="name-cell">
                            <i class="ti ti-pencil" aria-hidden="true"></i>
                            @stationery.Name
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>