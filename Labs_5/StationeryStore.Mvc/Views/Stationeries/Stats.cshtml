@model StationeryStatsViewModel

@{
    ViewData["Title"] = "Stationery Stats";
    var outOfStockClass = Model.OutOfStockCount > 0 ? "stat-danger" : "stat-safe";
    var reorderClass = Model.NeedReorderCount > 0 ? "stat-warning" : "stat-safe";
}
<!-- set icon for stats of stationeries page-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<div class="page-header">
    <div>
        <h2 class="page-title">
            <i class="ti ti-chart-bar page-title-icon" aria-hidden="true"></i>
            <span>Stationery Stats</span>
        </h2>
        <p class="page-description">
            Trang này giúp bạn xem nhanh tổng quan tình hình tồn kho của cửa hàng.
        </p>
    </div>

     <a class="btn btn-theme-back" href="/Stationeries">
        <i class="ti ti-arrow-left" aria-hidden="true"></i>
        Quay lại danh sách
    </a>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <i class="ti ti-box stat-icon" aria-hidden="true"></i>
        <div class="stat-number">@Model.TotalStationeries</div>
        <div class="stat-label">Tổng số loại sản phẩm</div>
    </div>

    <div class="stat-card">
        <i class="ti ti-packages stat-icon" aria-hidden="true"></i>
        <div class="stat-number">@Model.TotalQuantity</div>
        <div class="stat-label">Tổng số lượng tồn kho</div>
    </div>

    <div class="stat-card">
        <i class="ti ti-cash stat-icon" aria-hidden="true"></i>
        <div class="stat-number">@Model.TotalInventoryValueText</div>
        <div class="stat-label">Tổng giá trị tồn kho</div>
    </div>
    

    <div class="stat-card @outOfStockClass">
        <i class="ti @(Model.OutOfStockCount > 0 ? "ti-alert-triangle" : "ti-shield-check") stat-icon" aria-hidden="true"></i>
        <div class="stat-number">@Model.OutOfStockCount</div>
        <div class="stat-label">Sản phẩm đã hết hàng</div>
    </div>

    <div class="stat-card @reorderClass">
        <i class="ti @(Model.NeedReorderCount > 0 ? "ti-refresh-alert" : "ti-shield-check") stat-icon" aria-hidden="true"></i>
        <div class="stat-number">@Model.NeedReorderCount</div>
        <div class="stat-label">Sản phẩm cần nhập thêm</div>
    </div>
</div>

<div class="info-panel stationery-panel">
    <div class="stationery-panel-title">
        <i class="ti ti-clipboard-check" aria-hidden="true"></i>
        Đánh giá tình hình tồn kho
    </div>

    @if (Model.OutOfStockCount > 0)
    {
        <p class="text-danger">
            Có sản phẩm đã hết hàng. Cần kiểm tra và nhập thêm sớm.
        </p>
    }
    else if (Model.NeedReorderCount > 0)
    {
        <p class="text-warning">
            Một số sản phẩm gần hết hàng. Nên lập kế hoạch nhập thêm.
        </p>
    }
    else
    {
        <p class="text-success">
            Tồn kho hiện tại đang ổn định.
        </p>
    }
</div>

<div class="catalog-table-wrap stats-table-wrap">
    <table class="catalog-table">
        <tbody>
            <tr>
                <th>Tổng số loại sản phẩm</th>
                <td>@Model.TotalStationeries</td>
            </tr>

            <tr>
                <th>Tổng số lượng tồn kho</th>
                <td>@Model.TotalQuantity</td>
            </tr>

            <tr>
                <th>Tổng giá trị tồn kho</th>
                <td>@Model.TotalInventoryValueText</td>
            </tr>

            <tr>
                <th>Số sản phẩm đã hết hàng</th>
                <td>@Model.OutOfStockCount</td>
            </tr>

            <tr>
                <th>Số sản phẩm cần nhập thêm</th>
                <td>@Model.NeedReorderCount</td>
            </tr>
        </tbody>
    </table>
</div>