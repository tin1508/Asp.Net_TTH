@model StationeryEditViewModel

@{
    ViewData["Title"] = "Edit Stationery";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Chỉnh sửa Văn Phòng Phẩm</h2>
    </div>

    <a class="btn btn-theme-back"
       asp-controller="Stationeries"
       asp-action="Index">
       
        Quay lại danh sách
    </a>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="error-box">
        <i class="ti ti-alert-circle"></i>
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">
        <i class="ti ti-check"></i>
        @TempData["SuccessMessage"]
    </div>
}
<div class="form-layout">
    <form class="form-box"
          asp-controller="Stationeries"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Sku"/>
        <input type="hidden" asp-for="CategoryName"/>
        <input type="hidden" asp-for="RowVersion"/>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"></div>
        }

        <div class="form-group">
            <label>Mã sản phẩm</label>
            <input value="@Model.Sku"
                    class="form-control"
                    disabled/>
        </div>

        <div class="form-group">
            <label asp-for="Name">Tên sản phẩm</label>
            <input asp-for="Name"
                   class="form-control"
                   placeholder="Ví dụ: Blue BallPoint Pen" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Danh Mục</label>
            <input value="@Model.CategoryName"
                    class="form-control"
                    disabled/>
        </div>


        <div class="form-group">
            <label asp-for="Supplier">Nhà cung cấp</label>
            <input asp-for="Supplier"
                   class="form-control"
                   placeholder="Ví dụ: EraserTech" />
            <span asp-validation-for="Supplier" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="UnitPrice">Giá bán</label>
            <input asp-for="UnitPrice"
                   class="form-control"
                   placeholder="Ví dụ: 450000" />
            <span asp-validation-for="UnitPrice" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Quantity">Số lượng</label>
            <input asp-for="Quantity"
                   class="form-control"
                   placeholder="Ví dụ: 12" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MinStock">Mức tồn tối thiểu</label>
            <input asp-for="MinStock"
                   class="form-control"
                   placeholder="Ví dụ: 5" />
            <span asp-validation-for="MinStock" class="text-danger"></span>
        </div>

        <button class="btn" type="submit">
            Lưu Sản phẩm
        </button>

        <a class="btn btn-secondary"
           asp-controller="Stationeries"
           asp-action="Index">
            Quay lại
        </a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(partialViewName: "_ValidationScriptsPartial");
    }
}