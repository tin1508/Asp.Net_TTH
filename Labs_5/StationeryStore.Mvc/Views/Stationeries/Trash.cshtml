@model List<StationeryTrashViewModel>
@{
    ViewData["Title"] = "Stationery Trash";
}

<div class="page-header" style="margin-top: 1.5rem">
    <div>
        <h1 class="page-title">Stationery Trash</h1>
        <p class="page-description">Các văn phỏng phẩm đã bị xóa.</p>
    </div>
    <a asp-controller="Stationeries" asp-action="Index" class="btn btn-theme-back">
        Quay lại danh sách
    </a>
</div>
@if(TempData["RestoreSuccessfully"] != null){
    <div class="success-box">
        <i class="ti ti-check"></i>
        @TempData["RestoreSuccessfully"]
    </div>
}
@if(TempData["NotFoundMessage"] != null){
    <div class="error-box">
        <i class="ti ti-alert-circle"></i>
        @TempData["ErrorMessage"]
    </div>
}

<div class="detail-layout" style="margin-bottom: 2rem; display: block;">
    <div class="catalog-table-wrap">
        <table class="catalog-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>SKU</th>
                    <th>Tên sản phẩm</th>
                    <th>Thời gian xóa</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
               @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align:center; color:#94a3b8;">
                            Không có sản phẩm nào trong thùng rác.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Sku</td>
                        <td class="name-cell">@item.Name</td>
                        <td style="color:#94a3b8;">
                            @item.DeletedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            <form asp-controller="Stationeries"
                                  asp-action="Restore"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-secondary">
                                    <i class="ti ti-restore"></i> Khôi phục
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>