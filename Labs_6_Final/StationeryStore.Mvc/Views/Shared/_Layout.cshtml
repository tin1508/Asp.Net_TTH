@{
    var canManage = (await AuthorizationService.AuthorizeAsync(User, "CanManageStationery")).Succeeded;
    var canViewDashboard = (await AuthorizationService.AuthorizeAsync(User, "CanViewDashboard")).Succeeded;
    var canViewOrders = (await AuthorizationService.AuthorizeAsync(User, "CanViewOrders")).Succeeded;
    var canViewAuditLogs = (await AuthorizationService.AuthorizeAsync(User, "CanViewAuditLogs")).Succeeded;
    var canViewDataHealth = (await AuthorizationService.AuthorizeAsync(User, "CanViewDataHealth")).Succeeded;
    var canViewCart = (await AuthorizationService.AuthorizeAsync(User, "CanViewCart")).Succeeded;
    var canViewProfile = (await AuthorizationService.AuthorizeAsync(User, "CanViewProfile")).Succeeded;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isOnLoginPage = currentController == "Authentication" && currentAction == "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hoang's-MSStore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StationeryStore.Mvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Hoang's-MSStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if(canViewDashboard){
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Stationeries" asp-action="Index">Stationeries</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">Categories</a>
                        </li>
                        @if(canViewOrders){
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Index">Orders</a>
                            </li>
                        }
                        @if(canViewDataHealth){
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="DataHealth" asp-action="Index">Data Health</a>
                            </li>
                        }
                        @if(canViewAuditLogs){
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="AuditLogs" asp-action="Index">Audit Log</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (canViewCart)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                    <i class="ti ti-shopping-cart"></i> Giỏ hàng
                                </a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="ti ti-user-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                    @if (canViewProfile)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="ProfileUsers" asp-action="Index">
                                                <i class="ti ti-user"></i> Hồ sơ
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Authentication" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="ti ti-logout"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            if (!isOnLoginPage)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Authentication" asp-action="Login">Đăng nhập</a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - StationeryStore.Mvc.ByHoangDev - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
