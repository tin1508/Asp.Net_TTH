@model StationeryListItemViewModel

@{
    var canManage = (await AuthorizationService.AuthorizeAsync(User, "CanManageStationery")).Succeeded;
    var isCustomer = User.IsInRole("Customer");
}

<div class="stationery-card">
    @if(canManage){
        <div class="card-top-actions">
            <a asp-controller="Stationeries"
                asp-action="Edit"
                asp-route-id="@Model.Id"
                class="btn btn-sm btn-edit"
                title="Chỉnh sửa">
                <i class="ti ti-edit"></i>
            </a>
            <form asp-controller="Stationeries"
                asp-action="DeleteStationery"
                asp-route-id="@Model.Id"
                method="post"
                onsubmit="return confirm('Bạn có chắc chắn muốn xóa @Model.Name')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-delete" title="Xóa">
                    <i class="ti ti-trash"></i>
                </button>
            </form>
        </div>
    }
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>
        <p class="card-sku">SKU: @Model.Sku</p>
        <p class="card-category">Danh mục: @Model.Category?.Name</p>

        <div class="card-info">
            <span class="card-price">@Model.PriceText</span>
            <span class="card-quantity">Số lượng: @Model.Quantity</span>
        </div>

        <div class="card-bottom">
            @if (Model.StockStatus == "In stock")
            {
                <span class="badge badge-success">@Model.StockStatus</span>
            }
            else if (Model.StockStatus == "Need to add more stock")
            {
                <span class="badge badge-warning">@Model.StockStatus</span>
            }
            else
            {
                <span class="badge badge-danger">@Model.StockStatus</span>
            }

            <div class="card-actions">
                <a class="btn btn-sm btn-primary"
                   asp-controller="Stationeries"
                   asp-action="Detail"
                   asp-route-id="@Model.Id">
                    <i class="ti ti-eye"></i> Chi tiết
                </a>
                @if (isCustomer)
                {
                    <div class="card-actions-row">
                        @if (Model.StockStatus == "In stock" || Model.StockStatus == "Need to add more stock")
                        {
                            <form asp-controller="Stationeries" asp-action="AddToCart" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="stationeryId" value="@Model.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-sm btn-success" title="Thêm vào giỏ hàng">
                                    <i class="ti ti-shopping-cart-plus"></i> Thêm vào giỏ
                                </button>
                            </form>

                            <form asp-controller="Stationeries" asp-action="BuyNowStationery" method="post" class="d-inline"
                                onsubmit="return confirm('Mua ngay sản phẩm này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="stationeryId" value="@Model.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-sm btn-warning" title="Mua ngay">
                                    <i class="ti ti-bolt"></i> Mua ngay
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled title="Sản phẩm đã hết hàng">
                                <i class="ti ti-ban"></i> Hết hàng
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>