@model CategorySearchViewModel

@{
    ViewData["Title"] = "Search Categories";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Search Categories</h2>
        <p class="page-description">
            Form GET dùng Query String để tìm kiếm danh mục sản phẩm theo từ khóa.
        </p>
    </div>
    <a class="btn btn-theme-back"
       asp-controller="Categories"
       asp-action="Index">
        Quay lại danh sách
    </a>
</div>

<div class="form-layout">
    <form class="form-box"
          asp-controller="Categories"
          asp-action="Search"
          method="get">

        <div class="form-group">
            <label asp-for="Keyword">Từ khóa</label>
            <input asp-for="Keyword"
                   class="form-control"
                   placeholder="Ví dụ: bút viết,..." />
        </div>
        <button class="btn" type="submit">
            Tìm Kiếm
        </button>
        <a class="btn btn-secondary"
           asp-controller="Categories"
           asp-action="Search">
            Xóa
        </a>
    </form>
    <div>
        <h3>Search Result</h3>

        <p>
            Keyword: <strong>@Model.Keyword</strong>
        </p>
        
        @if(Model == null){
            <div class="empty-state">
                <i class="ti ti-inbox" aria-hidden="true"></i>
                <p>không có sản phẩm nào trong hệ thống.</p>
            </div>
        }
        else{
            <div class="catalog-table-wrap">
                <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
                    <table class="catalog-table">
                        <thead>
                            <tr>
                                <th><i class="ti ti-folder" aria-hidden="true"></i> Tên Danh mục sản phẩm</th>
                                <th><i class="ti ti-eye" aria-hidden="true"></i> Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (StationeryListItemViewModel item in Model.Stationeries)
                            {
                                <tr>
                                    <td class="name-cell">@item.Name</td>
                                    <td class="action-cell">
                                        <a class="btn-detail" href="/Stationeries/Detail/@item.Id">
                                            <i class="ti ti-eye" aria-hidden="true"></i>
                                            Xem
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
