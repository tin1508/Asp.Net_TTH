@model UserProfileViewModel
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<div class="page-header">
    <div>
        <h2 class="page-title">
            <i class="ti ti-pencil page-title-icon" aria-hidden="true"></i>
            <span>Chỉnh sửa hồ sơ</span>
        </h2>
        <p class="page-description">
            Cập nhật họ tên, địa chỉ giao hàng và ngày sinh của bạn.
        </p>
    </div>
</div>

<div class="catalog-table-wrap p-4" style="max-width: 600px;">
    <form asp-controller = "ProfileUsers" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Họ tên</label>
            <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DefaultShippingAddress" class="form-label">Địa chỉ giao hàng mặc định</label>
            <input asp-for="DefaultShippingAddress" class="form-control" placeholder="Nhập địa chỉ giao hàng" />
            <span asp-validation-for="DefaultShippingAddress" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-create">
                <i class="ti ti-check"></i> Lưu thay đổi
            </button>
            <a asp-action="Index" class="btn btn-theme-back">
                <i class="ti ti-x" aria-hidden="true"></i>
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}