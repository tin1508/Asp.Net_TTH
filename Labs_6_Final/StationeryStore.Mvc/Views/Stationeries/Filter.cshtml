@model StationeryFilterViewModel

@{
    ViewData["Title"] = "Filter Stationeries";
}

<div class="page-header" style="margin-top: 1.5rem; margin-bottom: 2rem;">
    <h1 class="page-title">Tra cứu văn phòng phẩm</h1>
</div>

<form method="get" asp-action="Filter" asp-controller="Stationeries" style="margin-bottom: 2rem; background: #1e1e2e; padding: 20px; border-radius: 8px;">
    <div style="display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap;">
        
        <div>
            <label style="color: #94a3b8; font-size: 14px; margin-bottom: 5px; display: block;">Danh mục</label>
            <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" style="padding: 8px; border-radius: 4px; background: #2a2d3e; color: white; border: 1px solid #3b3f54;">
                <option value="">-- Tất cả danh mục --</option>
            </select>
        </div>

        <div>
            <label style="color: #94a3b8; font-size: 14px; margin-bottom: 5px; display: block;">Giá từ</label>
            <input type="number" asp-for="MinPrice" style="padding: 8px; border-radius: 4px; background: #2a2d3e; color: white; border: 1px solid #3b3f54;" placeholder="VD: 10000" />
        </div>

        <div>
            <label style="color: #94a3b8; font-size: 14px; margin-bottom: 5px; display: block;">Giá đến</label>
            <input type="number" asp-for="MaxPrice" style="padding: 8px; border-radius: 4px; background: #2a2d3e; color: white; border: 1px solid #3b3f54;" placeholder="VD: 500000" />
        </div>

        <div>
            <button type="submit" class="btn btn-primary" style="padding: 9px 20px;">Lọc Dữ Liệu</button>
            <a asp-action="Filter" class="btn-theme-back" style="padding: 9px 20px; text-decoration: none;">Xóa bộ lọc</a>
        </div>
    </div>
</form>

<div class="catalog-table-wrap">
    <table class="catalog-table" style="width: 100%;">
        <thead style="background-color: #2a2d3e; color: #f8fafc; text-align: left;">
            <tr>
                <th style="padding: 12px; border-bottom: 2px solid #3b3f54;">Tên sản phẩm</th>
                <th style="padding: 12px; border-bottom: 2px solid #3b3f54;">Danh mục (Relationship)</th>
                <th style="padding: 12px; border-bottom: 2px solid #3b3f54;">Đơn giá</th>
                <th style="padding: 12px; border-bottom: 2px solid #3b3f54;">Tồn kho</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Results.Any())
            {
                <tr>
                    <td colspan="5" style="text-align: center; padding: 20px; color: #94a3b8;">Không tìm thấy sản phẩm nào.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Results)
                {
                    <tr style="border-bottom: 1px solid #1e1e2e;">
                        <td style="padding: 12px;">
                            <strong>@item.Name</strong>
                            <br />
                            <small style="color: gray;">SKU: @item.Sku</small>
                        </td>
                        
                        <td style="padding: 12px; color: #a855f7;">@(item.Category?.Name ?? "Không có")</td> 
                        
                        <td style="padding: 12px;">@item.PriceText</td>
                        
                        <td style="padding: 12px;">
                            <span class="@item.StockStatusClass">@item.StockStatus</span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>