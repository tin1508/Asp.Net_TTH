@model List<StationeryListItemViewModel>

@{
    ViewData["Title"] = "Stationeries Catalog";
    var totalItems = Model.Count;
    var canManage = (await AuthorizationService.AuthorizeAsync(User, "CanManageStationery")).Succeeded;
}

<!-- set up icon for stationeries list page-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">

<div class="page-header">
    <div>
        <h2 class="page-title">
            <i class="ti ti-pencil page-title-icon" aria-hidden="true"></i>
            <span>Stationeries Catalog</span>
        </h2>
        <p class="page-description">
            Đây là trang danh sách sản phẩm của cửa hàng.
        </p>
    </div>
    @if(canManage){
        <div>
            <a class="btn btn-create"
            asp-controller="Stationeries"
            asp-action="Create">Tạo Mới</a>

            <a class="btn btn-search"
            asp-controller="Stationeries"
            asp-action="Trash">Thùng rác</a>
        </div>

        <div>
            <a class="btn btn-primary" href="/Stationeries/Stats">
                <i class="ti ti-chart-bar" aria-hidden="true"></i>
                Xem thống kê tồn kho
            </a>
        </div>
    }
</div>
<div class="filter-container mb-4 p-3 rounded">
    <form asp-controller="Stationeries" asp-action="Search" method="get" class="d-flex gap-3 align-items-end">
        <div class="flex-grow-1">
            <label class="form-label filter-label">Từ khóa</label>
            <input type="text" name="keyword" class="form-control bg-dark text-white border-secondary"
                    placeholder="Nhập tên sản phẩm..."
                    value="@Context.Request.Query["keyword"]"/>
        </div>
        <div style="width: 250px;">
            <label class="form-label filter-label">Giá tối thiểu</label>
            
            <input type="text" id="displayMinPrice" class="form-control bg-dark text-white border-secondary"
                placeholder="Ví dụ: 300000" />
                
            <input type="hidden" id="actualMinPrice" name="minPrice"
                value="@Context.Request.Query["minPrice"]" />
        </div>
        <div style="width: 200px">
            <label class="form-label filter-label">Danh mục</label>
            <select name="categoryName" class="form-control form-select bg-dark text-white border-secondary">
                <option value="">Tất cả danh mục</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (string category in ViewBag.Categories)
                    {
                        <option value="@category" selected="@(Context.Request.Query["categoryName"] == category)">@category</option>
                    }
                }
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-create">Lọc kết quả</button>
            <a href="/Stationeries" class="btn btn-outline-light ms-2">Xóa lọc</a>
        </div>
    </form>
</div>
@if (TempData["SuccessMessage"] != null){
    <div class="success-box">
        @TempData["SuccessMessage"]
    </div>
}

<div class="info-panel">
    <i class="ti ti-package info-panel-icon" aria-hidden="true"></i>
    <div>
        <span class="info-panel-label">Tổng số sản phẩm</span>
        <span class="info-panel-value">@totalItems</span>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="ti ti-inbox" aria-hidden="true"></i>
        <p>Chưa có sản phẩm nào trong hệ thống.</p>
    </div>
}
else
{
    <div class="stationery-grid">
        @foreach(var item in Model){
            <partial name="_StationeryCard" model="item"/>
        }
    </div>     
}

@if(canManage){
    <div class="mt-4">
        <a class="btn btn-theme-back" href="/">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            Quay lại trang chủ
        </a>
    </div>
}
@section Scripts{
    <script src="~/js/site.js" asp-append-version="true"></script>
}
